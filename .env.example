# DROPONCE Environment Configuration
# Copy this file to .env and fill in your values.

# ─── Mode Toggle ────────────────────────────────────────────────────────────────
# "true"  → zero-dependency local simulation (IndexedDB, no internet required)
# "false" → connects to real Supabase backend
VITE_USE_MOCK_API=true

# ─── Supabase (required when VITE_USE_MOCK_API=false) ───────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# That's it! Files are stored in Supabase Storage — no Cloudflare R2 needed.
# Edge Function secrets (SUPABASE_SERVICE_ROLE_KEY) are set via the Supabase CLI,
# never exposed to the frontend.
