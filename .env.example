# DROPONCE Environment Configuration

# Set to "false" to connect to real Supabase & Cloudflare R2 backend
# Set to "true" for zero-dependency high-fidelity in-browser simulation (default for instant testing)
VITE_USE_MOCK_API=true

# Supabase Configuration (Leave empty if using mock mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare R2 Public Download Domain or Edge Function API endpoint
VITE_API_BASE_URL=
